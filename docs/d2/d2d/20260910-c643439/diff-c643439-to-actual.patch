+                .map(|x| x.to_string())
+                .unwrap_or_else(|| "null".into()),
+            if i + 1 == report.records.len() {
+                "\n"
+            } else {
+                ",\n"
+            }
+        ));
+    }
+    s.push_str("  ],\n");
+    s.push_str("  \"pairs\": [\n");
+    for (i, p) in report.pairs.iter().enumerate() {
+        s.push_str(&format!(
+            "    {{\"seed\": {}, \"diff\": {:.1}}}{}",
