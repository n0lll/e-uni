+fn c5_scenario(seed: u64, freeze: bool) -> Scenario {
+    Scenario {
+        group: if freeze {
+            "C5-freeze".into()
+        } else {
+            "C5-learn".into()
+        },
+        seed,
+        freeze_learning: freeze,
+        control: ControlMode::Neural,
+        switch_tick: Some(D1_SWITCH_TICK),
+        max_ticks: D1_MAX_TICKS,
+        place: None,
+        heading: None,
+        dark: false,
+        collect_decisions: false,
+    }
+}
