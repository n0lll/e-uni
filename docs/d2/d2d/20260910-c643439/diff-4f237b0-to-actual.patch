+#[derive(Clone, Debug)]
+pub struct SourceFileEntry {
+    pub path: String,
+    pub sha256: String,
+}
+
+#[derive(Clone, Debug)]
+pub struct ExecutionSourceManifest {
+    pub algorithm: String,
+    pub digest: String,
+    pub files: Vec<SourceFileEntry>,
+    pub git_commit: String,
+    pub git_dirty: bool,
+    pub git_porcelain: String,
+    pub execution_source_differs_from_head: bool,
+    pub rustc: String,
+    pub cargo: String,
+}
