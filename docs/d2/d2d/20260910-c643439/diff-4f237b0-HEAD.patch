+        sum += dth;
+    }
+    let d5 = diag_at(&w, 5);
+    assert!((d5.w_effective - 1.0).abs() < 1e-12);
+    assert!((d5.obs[29] - 1.0).abs() < 0.05, "obs[29]={}", d5.obs[29]);
+    let expect = 12.0 * tick_dt(&w.spec) * w.spec.physics.max_angular_speed;
+    assert!((sum - expect).abs() < 1e-6, "sum={sum} expect={expect}");
+}
